    <style id="final-client-polish-v2">
      /* =========================================================
   FINAL CLIENT POLISH — ATAAM BRAND + RESPONSIVE PROTOTYPE
   ========================================================= */
      :root {
        --sfx-deep: #043a2b;
        --sfx-dark: #06533e;
        --sfx-mid: #007a5e;
        --sfx-blue: #00936d;
        --sfx-cyan: #1ef7c4;
        --sfx-pale: #dcfff6;
      }

      /* Navigation: retain Ferrn lockup, refine all CTA buttons in Ataam colours. */
      .topbar {
        padding: 8px 10px;
        border: 1px solid rgba(0,122,94, 0.14);
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 12px 34px rgba(6,38,30, 0.1);
      }
      .topbar .agency-copy b {
        color: #0a0a0a;
      }
      .topbar .agency-copy span {
        color: #5e6b66;
      }
      .topbar .btn {
        min-height: 44px;
        padding: 0 18px;
        border-radius: 999px;
        border: 1px solid transparent;
        gap: 9px;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(6,38,30, 0.1);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }
      .topbar .btn svg {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
      }
      .topbar .btn.primary {
        background: var(--sfx-dark);
        color: #fff;
        border-color: var(--sfx-dark);
      }
      .topbar .btn.secondary {
        background: var(--sfx-blue);
        color: #fff;
        border-color: var(--sfx-blue);
      }
      .topbar .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 26px rgba(6,38,30, 0.16);
      }
      .topbar .btn.primary:hover {
        background: #06261e;
        border-color: #06261e;
      }
      .topbar .btn.secondary:hover {
        background: #008a66;
        border-color: #008a66;
      }

      /* 02 — intentionally darker client-blue environment. */
      #approach {
        background: var(--sfx-deep) !important;
      }
      #approach .section-no {
        color: var(--sfx-cyan) !important;
      }
      #approach .lead {
        color: rgba(210,250,236, 0.76) !important;
      }
      #approach .step {
        background: rgba(255, 255, 255, 0.045);
        border-color: rgba(30,247,196, 0.16);
      }
      #approach .step p {
        color: rgba(210,250,236, 0.72) !important;
      }
      #approach .step span {
        background: var(--sfx-blue) !important;
        color: #fff !important;
      }
      #approach .demo-experience {
        background: #032f23 !important;
        border-color: rgba(30,247,196, 0.24) !important;
      }
      #approach .demo-tabs {
        background: #02241b !important;
      }
      #approach .demo-tab {
        background: #074232 !important;
      }
      #approach .demo-tab.active {
        background: #0b654d !important;
        box-shadow: inset 0 -3px 0 var(--sfx-blue) !important;
      }
      #approach .demo-tab small {
        color: rgba(210,250,236, 0.62) !important;
      }

      /* Fit both prototype views to their container on every screen. */
      #approach .method-grid,
      #approach .method-grid > div,
      #approach .demo-experience,
      #approach .demo-panel,
      #approach .prototype,
      #approach .browser,
      #approach .app,
      #approach .dash,
      #approach .mobile-prototype {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box;
      }
      #approach .demo-panel {
        overflow: hidden !important;
        padding: 12px !important;
      }
      #approach .demo-panel[data-demo-panel="desktop"] .prototype {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        padding: 12px !important;
      }
      #approach .browser {
        width: 100% !important;
      }
      #approach .app {
        grid-template-columns: clamp(100px, 19%, 150px) minmax(0, 1fr) !important;
        width: 100% !important;
      }
      #approach .side {
        min-width: 0 !important;
      }
      #approach .dash {
        overflow: hidden !important;
      }
      #approach .stat-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      }
      #approach .dash-panels {
        grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr) !important;
      }
      #approach .row {
        min-width: 0;
        gap: 8px;
      }
      #approach .row span {
        min-width: 0;
        overflow-wrap: anywhere;
      }
      #approach .mobile-prototype {
        width: 100% !important;
        min-width: 0 !important;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 260px) !important;
        gap: 22px !important;
        padding: 22px !important;
      }
      #approach .phone-frame {
        width: min(238px, 100%) !important;
        max-width: 100% !important;
      }

      /* Scope timeline — dark blue instead of black, with blue-toned copy. */
      #scope .timeline {
        background: var(--sfx-dark) !important;
        color: var(--sfx-pale) !important;
      }
      #scope .timeline h3 {
        color: white !important;
      }
      #scope .timeline-row {
        border-color: rgba(0,147,109, 0.22) !important;
      }
      #scope .timeline-row strong,
      #scope .month b {
        color: #00936d !important;
      }
      #scope .timeline-row span,
      #scope .month span {
        color: #b8f5e3 !important;
      }
      #scope .month {
        background: rgba(0,147,109, 0.09) !important;
        border: 1px solid rgba(0,147,109, 0.13);
      }

      /* Project links use the requested blue. */
      #team .project-link-btn {
        color: #00936d !important;
      }
      #team .project-link-btn:hover {
        color: #008a66 !important;
      }

      /* Ferrn closing/contact panel is deliberately fully black. */
      #team .ferrn-contact-card {
        background: #000 !important;
        border-color: rgba(255, 255, 255, 0.12) !important;
      }
      #team .ferrn-contact-brand span {
        color: rgba(255, 255, 255, 0.66) !important;
      }
      #team .ferrn-contact-links {
        flex-wrap: wrap;
      }
      #team .website-contact,
      #team .email-contact {
        display: block;
      }
      #team .website-contact small,
      #team .website-contact strong,
      #team .email-contact small,
      #team .email-contact strong {
        display: block;
      }
      #team .email-contact small {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.55);
      }
      #team .email-contact strong {
        font-size: 14px;
        color: #fff;
        margin-top: 3px;
      }
      #team .social-links a:hover {
        background: #00936d !important;
      }

      @media (max-width: 980px) {
        #approach .mobile-prototype {
          grid-template-columns: 1fr !important;
        }
        #approach .phone-frame {
          width: min(260px, 100%) !important;
        }
        #approach .dash-panels {
          grid-template-columns: 1fr !important;
        }
      }
      @media (max-width: 720px) {
        #approach .demo-tabs {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
        #approach .demo-tab {
          min-width: 0 !important;
          padding: 8px 9px !important;
          grid-template-columns: 30px minmax(0, 1fr) !important;
        }
        #approach .demo-tab > span {
          width: 28px !important;
          height: 28px !important;
        }
        #approach .demo-tab b,
        #approach .demo-tab small {
          white-space: normal !important;
          overflow-wrap: anywhere;
        }
        #approach .app {
          grid-template-columns: 88px minmax(0, 1fr) !important;
        }
        #approach .side {
          padding: 12px 7px !important;
        }
        #approach .side-brand {
          font-size: 14px !important;
          letter-spacing: 0.08em !important;
        }
        #approach .navitem {
          font-size: 14px !important;
          padding: 6px !important;
        }
        #approach .dash {
          padding: 12px !important;
        }
        #approach .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
        #approach .dash-panels {
          grid-template-columns: 1fr !important;
        }
        #approach .panel {
          min-width: 0 !important;
        }
        #approach .mobile-prototype {
          padding: 16px !important;
        }
      }
      @media (max-width: 480px) {
        .topbar {
          width: calc(100% - 16px);
          padding: 7px 8px;
        }
        .topbar .ferrn {
          width: 34px;
          height: 34px;
          flex-basis: 34px;
        }
        .topbar .btn {
          min-height: 40px;
          padding: 0 12px;
          font-size: 14px;
        }
        .topbar .top-actions {
          gap: 6px;
        }
        #approach .demo-panel {
          padding: 7px !important;
        }
        #approach .prototype {
          padding: 7px !important;
        }
        #approach .browser-top {
          height: 30px !important;
          padding: 0 9px !important;
        }
        #approach .app {
          grid-template-columns: 74px minmax(0, 1fr) !important;
        }
        #approach .side {
          padding: 10px 5px !important;
        }
        #approach .side-brand {
          font-size: 14px !important;
          margin-bottom: 14px !important;
        }
        #approach .navitem {
          font-size: 14px !important;
          padding: 5px 4px !important;
        }
        #approach .dash {
          padding: 8px !important;
        }
        #approach .dash-head h3 {
          font-size: 18px !important;
        }
        #approach .stat {
          padding: 7px !important;
        }
        #approach .row {
          font-size: 14px !important;
          align-items: flex-start;
          flex-direction: column;
        }
        #approach .mobile-explainer h3 {
          font-size: 27px !important;
        }
        #team .ferrn-contact-links {
          width: 100%;
        }
      }

      /* Keep these same colours in the generated PDF. */
      @media print {
        #approach {
          background: var(--sfx-deep) !important;
        }
        #scope .timeline {
          background: var(--sfx-dark) !important;
          color: var(--sfx-pale) !important;
        }
        #scope .timeline-row strong,
        #scope .month b {
          color: #00936d !important;
        }
        #scope .timeline-row span,
        #scope .month span {
          color: #b8f5e3 !important;
        }
        #team .project-link-btn {
          color: #00936d !important;
        }
        #team .ferrn-contact-card {
          background: #000 !important;
        }
        #team .email-contact small,
        #team .email-contact strong {
          font-size: 9px !important;
        }
        #approach .demo-panel {
          overflow: hidden !important;
        }
        #approach .demo-panel[data-demo-panel="desktop"] .prototype {
          width: 100% !important;
          min-width: 0 !important;
        }
      }
    </style>
    <style id="pdf-layout-fit-v2">
