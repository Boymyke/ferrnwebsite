    <style>
      /* Delivery rhythm: full-width table beneath the module grid. */
      #scope .scope-grid {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 18px !important;
        align-items: start !important;
      }
      #scope .scope-grid > div:first-child {
        width: 100% !important;
        min-width: 0 !important;
      }
      #scope .delivery-timeline {
        width: 100% !important;
        min-width: 0 !important;
        margin-top: 2px !important;
        padding: 22px !important;
        border-radius: 24px !important;
        background: var(--sfx-dark, #071f19) !important;
        color: #fff !important;
        overflow: hidden !important;
      }
      #scope .delivery-timeline-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 24px;
        margin-bottom: 16px;
      }
      #scope .delivery-timeline-head h3 {
        margin: 0 0 5px !important;
        font-size: 26px !important;
        line-height: 1.05 !important;
        letter-spacing: -0.035em !important;
        color: #fff !important;
      }
      #scope .delivery-timeline-head p {
        margin: 0;
        max-width: 690px;
        font-size: 13px;
        line-height: 1.5;
        color: #b8f5e3;
      }
      #scope .launch-chip {
        flex: 0 0 auto;
        min-width: 170px;
        padding: 10px 13px;
        border-radius: 14px;
        border: 1px solid rgba(0,147,109, 0.28);
        background: rgba(0,147,109, 0.1);
      }
      #scope .launch-chip span,
      #scope .launch-chip strong {
        display: block;
      }
      #scope .launch-chip span {
        margin-bottom: 3px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #b8f5e3;
      }
      #scope .launch-chip strong {
        font-size: 14px;
        letter-spacing: 0.04em;
        color: #00936d;
      }
      #scope .delivery-table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(0,147,109, 0.2);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.025);
        -webkit-overflow-scrolling: touch;
      }
      #scope .delivery-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
        table-layout: fixed;
      }
      #scope .delivery-table th,
      #scope .delivery-table td {
        text-align: left;
        vertical-align: top;
        border: 0;
      }
      #scope .delivery-table thead th {
        padding: 11px 14px;
        background: rgba(0,147,109, 0.12);
        border-bottom: 1px solid rgba(0,147,109, 0.24);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #8fe9cf;
      }
      #scope .delivery-table thead th:nth-child(1) { width: 55%; }
      #scope .delivery-table thead th:nth-child(2) { width: 22%; }
      #scope .delivery-table thead th:nth-child(3) { width: 23%; }
      #scope .delivery-table tbody td {
        padding: 12px 14px;
        border-top: 1px solid rgba(0,147,109, 0.14);
        font-size: 12px;
        line-height: 1.42;
        color: #d9fff5;
      }
      #scope .delivery-table tbody tr:first-child td {
        border-top: 0;
      }
      #scope .delivery-table tbody tr:hover {
        background: rgba(0,147,109, 0.055);
      }
      #scope .delivery-table td strong {
        display: block;
        margin-bottom: 3px;
        font-size: 12.5px;
        line-height: 1.32;
        color: #fff;
      }
      #scope .delivery-table td > span:not(.stage-pill) {
        display: block;
        color: #9fedd8;
      }
      #scope .stage-pill {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 5px 8px;
        border-radius: 999px;
        background: rgba(0,147,109, 0.12);
        border: 1px solid rgba(0,147,109, 0.2);
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #8fe9cf;
        white-space: nowrap;
      }
      #scope .stage-pill.launch {
        background: #00936d;
        border-color: #00936d;
        color: #fff;
      }

      @media (max-width: 720px) {
        #scope .scope-grid {
          gap: 12px !important;
        }
        #scope .delivery-timeline {
          padding: 15px !important;
          border-radius: 18px !important;
        }
        #scope .delivery-timeline-head {
          align-items: stretch;
          flex-direction: column;
          gap: 10px;
          margin-bottom: 12px;
        }
        #scope .delivery-timeline-head h3 {
          font-size: 21px !important;
        }
        #scope .delivery-timeline-head p {
          font-size: 12px;
        }
        #scope .launch-chip {
          min-width: 0;
          width: 100%;
        }
        #scope .delivery-table {
          min-width: 700px;
        }
      }

      @media print {
        #scope .scope-grid {
          grid-template-columns: 1fr !important;
          gap: 8px !important;
        }
        #scope .delivery-timeline {
          padding: 10px !important;
          break-inside: avoid !important;
        }
        #scope .delivery-timeline-head {
          margin-bottom: 6px !important;
        }
        #scope .delivery-timeline-head h3 {
          font-size: 14px !important;
        }
        #scope .delivery-timeline-head p {
          font-size: 8px !important;
          line-height: 1.25 !important;
        }
        #scope .launch-chip {
          min-width: 115px !important;
          padding: 5px 7px !important;
        }
        #scope .launch-chip span { font-size: 6.5px !important; }
        #scope .launch-chip strong { font-size: 8px !important; }
        #scope .delivery-table-wrap {
          overflow: visible !important;
        }
        #scope .delivery-table {
          min-width: 0 !important;
          width: 100% !important;
        }
        #scope .delivery-table thead th {
          padding: 4px 6px !important;
          font-size: 6.3px !important;
        }
        #scope .delivery-table tbody td {
          padding: 4px 6px !important;
          font-size: 6.8px !important;
          line-height: 1.2 !important;
        }
        #scope .delivery-table td strong {
          margin-bottom: 1px !important;
          font-size: 7px !important;
          line-height: 1.18 !important;
        }
        #scope .stage-pill {
          min-height: 0 !important;
          padding: 2px 4px !important;
          font-size: 5.8px !important;
        }
      }
    </style>
  
    <style id="budget-column-commercial-v3">
      /* Budget v3 — one-column commercial presentation */
      #budget .budget-layout {
        display: flex !important;
        flex-direction: column !important;
        gap: 18px !important;
        width: 100% !important;
      }
      #budget .budget-hero {
        min-height: 0 !important;
        width: 100% !important;
        padding: 30px !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 22px !important;
        align-items: stretch !important;
      }
      #budget .budget-inline-intro { margin: 0 !important; }
      #budget .budget-total-block { width: 100%; }
      #budget .budget-total-block .price { margin-top: 10px; }
      #budget .pay {
        width: 100%;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      }
      #budget .commercial-breakdown {
