    <style id="proposal-v2-adjustments">
      .section-label-only {
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 30px;
      }
      .section-label-only .section-no {
        font-size: 14px;
        letter-spacing: 0.13em;
      }
      .credentials .cred {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .project-link-btn {
        margin-top: auto;
        padding: 16px 0 0;
        border: 0;
        border-radius: 0;
        display: inline-block;
        min-height: 0;
        background: transparent;
        color: #007a5e;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
      }
      .project-link-btn:hover {
        transform: translateY(-1px);
        background: transparent;
        color: #007a5e;
        opacity: 0.72;
      }
      .project-link-btn:focus-visible {
        outline: 2px solid rgba(0,122,94, 0.3);
        outline-offset: 4px;
      }
      .hero-photo {
        background-image:
          linear-gradient(180deg, transparent 48%, rgba(0, 0, 0, 0.82)),
          var(--sf-hero) !important;
        background-size: cover;
        background-position: center;
      }
      .close-photo {
        background-image:
          linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.65)),
          var(--sf-close) !important;
        background-size: cover;
        background-position: center;
      }
      .demo-experience {
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 24px;
        overflow: hidden;
        background: #101010;
      }
      .demo-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #0a0a0a;
        gap: 1px;
      }
      .demo-tab {
        border: 0;
        background: #151515;
        color: #fff;
        padding: 10px 16px;
        text-align: left;
        display: grid;
        grid-template-columns: 38px 1fr;
        gap: 10px;
        align-items: center;
        cursor: pointer;
        min-height: 62px;
        position: relative;
      }
      .demo-tab > span {
        width: 34px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 14px;
      }
      .demo-tab b,
      .demo-tab small {
        display: block;
      }
      .demo-tab b {
        font-size: 16px;
      }
      .demo-tab small {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.56);
        margin-top: 3px;
      }
      .demo-tab.active {
        background: #000;
        box-shadow: inset 0 -3px 0 #007a5e;
      }
      .demo-panel {
        padding: 14px;
      }
      .demo-panel[hidden] {
        display: none !important;
      }
      .demo-panel .prototype {
        min-height: 0;
      }
      .mobile-prototype {
        min-height: 430px;
        border-radius: 18px;
        background: linear-gradient(145deg, #e8faf4, #eef8f5);
        display: grid;
        grid-template-columns: 1fr 280px;
        align-items: center;
        gap: 28px;
        padding: 28px;
        color: #0a0f0d;
      }
      .mobile-explainer h3 {
        font-size: 32px;
        line-height: 1.05;
        margin: 10px 0 14px;
        letter-spacing: -0.04em;
      }
      .mobile-explainer p {
        font-size: 14px;
        line-height: 1.6;
        color: #5e6b66;
      }
      .client-demo-label {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: #0f8a6a;
      }
      .mobile-points {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }
      .mobile-points span {
        font-size: 14px;
        padding: 8px 10px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid rgba(10,42,34, 0.14);
      }
      .phone-frame {
        width: 230px;
        margin: auto;
        background: #0a0a0a;
        border-radius: 34px;
        padding: 10px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.24);
        position: relative;
      }
      .phone-island {
        width: 74px;
        height: 18px;
        background: #0a0a0a;
        border-radius: 0 0 13px 13px;
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
      }
      .phone-screen {
        background: #f8fbfb;
        border-radius: 26px;
        overflow: hidden;
        min-height: 410px;
        padding: 27px 13px 12px;
      }
      .phone-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
      }
      .phone-head small,
      .phone-head b {
        display: block;
      }
      .phone-head small {
        font-size: 14px;
        color: #5e6b66;
      }
      .phone-head b {
        font-size: 15px;
      }
      .phone-head > span {
        font-size: 14px;
        font-weight: 800;
        background: #0a2a22;
        color: #fff;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
      }
      .shift-card {
        background: #0a2a22;
        color: #fff;
        border-radius: 16px;
        padding: 14px;
      }
      .shift-card small {
        font-size: 14px;
        color: #1ef7c4;
      }
      .shift-card h4 {
        font-size: 21px;
        margin: 7px 0;
      }
      .shift-card p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.68);
        margin-bottom: 10px;
      }
      .location-pill {
        font-size: 14px;
        background: rgba(30,247,196, 0.16);
        padding: 8px;
        border-radius: 9px;
        margin-bottom: 10px;
      }
      .shift-card button {
        width: 100%;
        border: 0;
        border-radius: 10px;
        background: #1ef7c4;
        color: #071f19;
        font-weight: 800;
        font-size: 14px;
        padding: 10px;
      }
      .phone-section {
        padding: 14px 2px 6px;
      }
      .phone-section > b {
        font-size: 15px;
      }
      .phone-section > div {
        display: grid;
        grid-template-columns: 28px 1fr;
        gap: 8px;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid rgba(10,42,34, 0.1);
      }
      .phone-section > div > span {
        font-size: 14px;
        font-weight: 800;
        color: #0f8a6a;
      }
      .phone-section p {
        margin: 0;
      }
      .phone-section strong,
      .phone-section small {
        display: block;
        font-size: 14px;
      }
      .phone-section small {
        color: #5e6b66;
        margin-top: 2px;
      }
      .phone-nav {
        display: flex;
        justify-content: space-around;
        font-size: 14px;
        padding-top: 10px;
        color: #5e6b66;
      }
      .phone-nav b {
        color: #0f8a6a;
      }
      .maintenance-card {
        margin-top: 14px;
        border-radius: 16px;
        background: #0a0a0a;
        color: #fff;
        padding: 18px;
      }
      .maintenance-main {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 24px;
        align-items: center;
      }
      .maintenance-card small {
        font-size: 14px;
        color: #007a5e;
        font-weight: 800;
        letter-spacing: 0.11em;
      }
      .maintenance-card h4 {
        font-size: 20px;
        margin: 5px 0 6px;
      }
      .maintenance-card p {
        font-size: 14px;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.64);
        margin: 0;
      }
      .maintenance-price {
        text-align: right;
      }
      .maintenance-price strong {
        display: block;
        font-size: 28px;
        color: #007a5e;
      }
      .maintenance-price span {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.68);
      }
      .hosting-included-card {
        margin-top: 16px;
        border: 1px solid rgba(0,122,94, 0.16);
        border-radius: 16px;
        background: #fff;
        padding: 18px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 24px;
        align-items: center;
        box-shadow: 0 10px 28px rgba(10,42,34, 0.06);
      }
      .hosting-included-card small {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 14px;
        color: #007a5e;
        font-weight: 800;
        letter-spacing: 0.11em;
      }
      .hosting-included-card h4 {
        font-size: 20px;
        margin: 5px 0 6px;
        color: var(--ink);
      }
      .hosting-included-card p {
        font-size: 14px;
        line-height: 1.55;
        color: var(--muted);
        margin: 0;
      }
      .hosting-included-price {
        text-align: right;
      }
      .hosting-included-price strong {
        display: block;
        font-size: 28px;
        color: #007a5e;
      }
      .hosting-included-price span {
        font-size: 14px;
        color: var(--muted);
      }
      @media (max-width: 900px) {
        .mobile-prototype {
          grid-template-columns: 1fr;
        }
        .phone-frame {
          width: 250px;
        }
        .maintenance-main {
          grid-template-columns: 1fr;
        }
        .maintenance-price,
        .hosting-included-price {
          text-align: left;
        }
        .hosting-included-card {
          grid-template-columns: 1fr;
        }
      }

      /* Lucide icons used inside CTA buttons */
      .btn [data-lucide],
      .close-actions [data-lucide] {
        width: 17px;
        height: 17px;
        flex: 0 0 17px;
        stroke-width: 2;
        vertical-align: middle;
      }
      .close-actions .approve {
        display: inline-flex;
        align-items: center;
        gap: 9px;
      }
    </style>
    <style id="approach-mobile-fix">
      /* Mobile/tablet layout fix for 02 · Approach */
      @media (max-width: 980px) {
        #approach .method-grid,
        #approach .method-grid > *,
        #approach .steps,
        #approach .step,
        #approach .step > div,
        #approach .demo-experience,
        #approach .demo-tabs,
        #approach .demo-tab,
        #approach .demo-tab > div {
          min-width: 0;
          max-width: 100%;
        }

        #approach .method-grid {
          width: 100%;
          overflow: hidden;
        }

        #approach .steps {
          width: 100%;
        }

        #approach .step {
          width: 100%;
          grid-template-columns: 40px minmax(0, 1fr);
          gap: 12px;
          padding: 14px;
          align-items: start;
        }

        #approach .step > div {
          width: 100%;
        }

        #approach .step b {
          font-size: 16px;
          line-height: 1.3;
          margin: 1px 0 5px;
        }

        #approach .step p {
          width: 100%;
          font-size: 14px;
          line-height: 1.55;
          white-space: normal;
          overflow-wrap: break-word;
          word-break: normal;
          margin: 0;
        }

        #approach .demo-experience {
          width: 100%;
          max-width: 100%;
          overflow: hidden;
        }

        #approach .demo-tabs {
          width: 100%;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }

        #approach .demo-tab {
          width: 100%;
          grid-template-columns: 32px minmax(0, 1fr);
          gap: 9px;
          min-height: 54px;
          padding: 8px 10px;
        }

        #approach .demo-tab > span {
          width: 30px;
          height: 30px;
        }

        #approach .demo-tab b {
          font-size: 14px;
          line-height: 1.2;
          white-space: normal;
        }

        #approach .demo-tab small {
          font-size: 14px;
          line-height: 1.25;
          white-space: normal;
          overflow-wrap: break-word;
        }

        /* Keep the product mockup at a useful laptop/phone size, but contain the
     extra width inside its own horizontal scroller instead of widening the page. */
        #approach .demo-panel {
          width: 100%;
          max-width: 100%;
          overflow-x: auto;
          overflow-y: hidden;
          -webkit-overflow-scrolling: touch;
          overscroll-behavior-x: contain;
          scrollbar-width: thin;
          padding: 10px;
        }

        #approach .demo-panel[data-demo-panel="desktop"] .prototype {
          width: 720px;
          min-width: 720px;
          max-width: none;
        }

        #approach .demo-panel[data-demo-panel="mobile"] .mobile-prototype {
          width: 650px;
          min-width: 650px;
          max-width: none;
        }
      }

      @media (max-width: 640px) {
        #approach .method-grid {
          gap: 16px;
        }

        #approach .steps {
          gap: 10px;
        }

        #approach .step {
          grid-template-columns: 36px minmax(0, 1fr);
          gap: 11px;
          padding: 13px 12px;
          border-radius: 14px;
        }

        #approach .step span {
          width: 32px;
          height: 32px;
          font-size: 14px;
        }

        #approach .step b {
          font-size: 16px;
        }

        #approach .step p {
          font-size: 14px;
          line-height: 1.55;
        }

        #approach .demo-tab {
          grid-template-columns: 28px minmax(0, 1fr);
          gap: 7px;
          padding: 8px;
          min-height: 52px;
        }

        #approach .demo-tab > span {
          width: 27px;
          height: 27px;
          font-size: 14px;
        }

        #approach .demo-panel {
          padding: 8px;
        }

        #approach .demo-panel[data-demo-panel="desktop"] .prototype {
          width: 700px;
          min-width: 700px;
        }

        #approach .demo-panel[data-demo-panel="mobile"] .mobile-prototype {
          width: 610px;
          min-width: 610px;
        }
      }
    </style>
    <style id="sfx-client-theme-v3">
      :root {
        --navy: #007a5e;
        --navy2: #0a3a2e;
        --blue: #00936d;
        --aqua: #1ef7c4;
        --mint: #eafcf7;
        --sky: #effffb;
        --ink: #0a5a44;
        --muted: #5e6b66;
        --paper: #f6fcfa;
        --soft: #eefbf7;
        --line: rgba(0,122,94, 0.14);
        --shadow: 0 22px 60px rgba(0,122,94, 0.12);
      }
      body {
        background: var(--paper);
        color: var(--ink);
      }
      ::selection {
        background: var(--blue);
        color: #fff;
      }
      /* Keep Ferrn identity on the left of the nav exactly as-is. */
      .topbar {
        border-color: rgba(0,122,94, 0.13);
        box-shadow: 0 12px 40px rgba(0,122,94, 0.09);
      }
      .topbar .btn.primary {
        background: var(--navy2);
        color: #fff;
      }
      .topbar .btn.primary:hover {
        background: var(--navy);
      }
      .topbar .btn.secondary {
        background: var(--blue);
        color: #fff;
      }
      .topbar .btn.secondary:hover {
        background: #08dba2;
      }
      .proposal-page.white {
        background: #fff;
      }
      .proposal-page.mint {
        background: linear-gradient(145deg, #fff, var(--mint));
      }
      .proposal-page.sky {
        background: linear-gradient(145deg, #fff, var(--sky));
      }
      .proposal-page.dark {
        background: var(--navy2);
      }
      .section-no {
        color: var(--blue);
      }
      .dark .section-no {
        color: var(--aqua);
      }
      .eyebrow {
        color: var(--navy);
        border-color: rgba(0,122,94, 0.18);
      }
      .eyebrow i {
        background: var(--aqua);
      }
      .display em,
      .title span {
        color: var(--blue);
      }
      .chip {
        border-color: rgba(0,122,94, 0.15);
        background: #fff;
        color: var(--ink);
      }
      .hero-photo {
        background-image:
          linear-gradient(180deg, transparent 48%, rgba(6,38,30, 0.78)),
          var(--sf-hero) !important;
      }
      .hero-card {
        background: rgba(255, 255, 255, 0.94);
        color: var(--ink);
        border: 1px solid rgba(0,122,94, 0.12);
      }
      .hero-card small {
        color: var(--blue);
      }
      .hero-card p {
        color: var(--muted);
      }
      .sfx-hero-logo {
        width: min(420px, 75%);
        margin-bottom: 22px;
      }
      .sfx-hero-logo img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
      }
      .problem-main,
      .budget-hero {
        background: linear-gradient(145deg, var(--navy2), var(--navy));
      }
      .problem-main .truth {
        background: rgba(255, 255, 255, 0.08);
      }
      .mini,
      .module,
      .allocation,
      .third,
      .person {
        border-color: rgba(0,122,94, 0.14);
      }
      .mini .section-no,
      .person .role {
        color: var(--blue);
      }
      /* Ataam-branded prototype */
      #approach {
        background: var(--navy2);
      }
      #approach .step span {
        background: var(--blue);
        color: #fff;
      }
      #approach .demo-experience {
        border-color: rgba(30,247,196, 0.24);
        background: #064b38;
      }
      #approach .demo-tabs {
        background: #063f30;
      }
      .demo-tab {
        background: #0a5b45;
      }
      .demo-tab.active {
        background: #074836;
        box-shadow: inset 0 -3px 0 var(--aqua);
      }
      #approach .stat.accent {
        background: var(--blue) !important;
        color: #fff !important;
      }
      .side {
        background: #0a3a2e !important;
      }
      .navitem.active {
        background: rgba(30,247,196, 0.18) !important;
        color: #fff !important;
        border-color: var(--aqua) !important;
      }
      #approach .side-brand,
      #approach .section-no,
      #approach .client-demo-label {
        color: var(--aqua) !important;
      }
      #approach .mobile-prototype {
        background: linear-gradient(145deg, #eefaf5, #e6fbf3);
      }
      #approach .phone-head > span,
      #approach .shift-card {
        background: var(--navy2);
      }
      #approach .shift-card small {
        color: var(--aqua);
      }
      #approach .shift-card button {
        background: var(--aqua);
        color: var(--navy2);
      }
      /* Budget uses client brand */
      #budget .allocation-row strong {
        color: var(--navy);
      }
      #budget .third-party {
        background: var(--mint);
      }
      #budget .maintenance-card {
        background: var(--navy2);
      }
      #budget .maintenance-card small,
      #budget .maintenance-price strong {
        color: var(--aqua);
      }
      /* Ready-to-begin CTA is now after pricing, not the closing page */
      #ready {
        background: linear-gradient(135deg, var(--navy2), #0b5a45);
      }
      #ready .section-no {
        color: var(--aqua);
      }
      #ready .close-copy h2 span {
        color: var(--aqua);
      }
      #ready .close-actions .approve {
        background: var(--aqua);
        color: var(--navy2);
      }
      #ready .close-actions .download {
        border-color: rgba(255, 255, 255, 0.3);
      }
      #ready .close-photo {
        background-image:
          linear-gradient(180deg, rgba(6,38,30, 0.05), rgba(6,38,30, 0.72)),
          var(--sf-close) !important;
      }
      /* Final Team + Credentials + Ferrn contact page: Ataam palette, subtle Ferrn orange only for delivery-partner identity. */
      #team.team-closing {
        background: linear-gradient(145deg, #f6fdfa, #e8faf4);
      }
      #team .person {
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,122,94, 0.05);
        min-height: 0;
      }
      #team .person .initials {
        background: var(--navy2);
      }
      #team .cred {
        background: var(--navy2);
      }
      #team .project-link-btn {
        color: #ff4100;
      }
      .ferrn-contact-card {
        margin-top: 14px;
        border-radius: 20px;
        background: #08382b;
        color: #fff;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .ferrn-contact-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .ferrn-contact-mark {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        overflow: hidden;
        flex: 0 0 42px;
      }
      .ferrn-contact-mark svg {
        width: 100%;
        height: 100%;
        display: block;
      }
      .ferrn-contact-brand strong,
      .ferrn-contact-brand span {
        display: block;
      }
      .ferrn-contact-brand strong {
        font-size: 16px;
      }
      .ferrn-contact-brand span {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.62);
        margin-top: 3px;
      }
      .ferrn-contact-links {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .website-contact small,
      .website-contact strong {
        display: block;
      }
      .website-contact small {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.55);
      }
      .website-contact strong {
        font-size: 14px;
        color: #fff;
        margin-top: 3px;
      }
      .social-links {
        display: flex;
        gap: 8px;
      }
      .social-links a {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        transition: 0.2s ease;
      }
      .social-links a:hover {
        background: #ff4100;
        transform: translateY(-2px);
      }
      .social-links svg {
        width: 18px;
        height: 18px;
        stroke-width: 1.8;
      }
      @media (max-width: 900px) {
        .ferrn-contact-card,
        .ferrn-contact-links {
          align-items: flex-start;
          flex-direction: column;
        }
        .sfx-hero-logo {
          width: min(330px, 88%);
        }
      }
      @media (max-width: 640px) {
        .social-links {
          flex-wrap: wrap;
        }
        .ferrn-contact-card {
          padding: 16px;
        }
        .sfx-hero-logo {
          margin-bottom: 16px;
        }
      }
      @media print {
        .sfx-hero-logo {
          width: 78mm;
          margin-bottom: 4mm;
        }
        #budget .budget-hero {
          min-height: 370px;
        }
        #ready .close-grid {
          min-height: 150mm;
        }
        #team .section-intro {
          margin-bottom: 7px;
        }
        #team .title {
          font-size: 24pt !important;
        }
        #team .team-grid {
          gap: 6px;
          margin-bottom: 7px;
        }
        #team .person {
          padding: 9px;
          min-height: 118px;
        }
        #team .person .initials {
          width: 28px;
          height: 28px;
          margin-bottom: 7px;
          font-size: 10px;
        }
        #team .person h3 {
          font-size: 13px;
          margin-bottom: 2px;
        }
        #team .person .role {
          font-size: 9px;
          margin-bottom: 4px;
          letter-spacing: 0.06em;
        }
        #team .person p {
          font-size: 9px;
          line-height: 1.3;
          margin: 0;
        }
        #team .credentials {
          gap: 6px;
        }
        #team .cred {
          padding: 9px;
        }
        #team .cred b {
          font-size: 11px;
          margin-bottom: 3px;
        }
        #team .cred p {
          font-size: 9px;
          line-height: 1.28;
        }
        #team .project-link-btn {
          font-size: 9px;
          padding-top: 5px;
        }
        #team .ferrn-contact-card {
          margin-top: 7px;
          padding: 8px 10px;
          border-radius: 10px;
        }
        #team .ferrn-contact-mark {
          width: 28px;
          height: 28px;
          flex-basis: 28px;
        }
        #team .ferrn-contact-brand strong {
          font-size: 11px;
        }
        #team .ferrn-contact-brand span,
        #team .website-contact small,
        #team .website-contact strong {
          font-size: 9px;
        }
        #team .social-links a {
          width: 25px;
          height: 25px;
        }
        #team .social-links svg {
          width: 12px;
          height: 12px;
        }
      }
    </style>
    <style id="budget-pdf-fit">
      @media print {
        #budget .section-intro {
          margin-bottom: 5px;
        }
        #budget .title {
          font-size: 24pt !important;
        }
        #budget .budget-hero {
          min-height: 315px !important;
          padding: 14px !important;
        }
        #budget .price {
          font-size: 34px !important;
        }
        #budget .allocation {
          padding: 10px !important;
        }
        #budget .allocation-row {
          padding: 4px 0 !important;
        }
        #budget .third-party {
          margin-top: 5px !important;
          padding: 8px !important;
        }
        #budget .third-grid {
          gap: 3px !important;
        }
        #budget .maintenance-card {
          margin-top: 5px !important;
          padding: 7px !important;
        }
        #budget .maintenance-card h4 {
          font-size: 12px !important;
          margin: 2px 0;
        }
        #budget .maintenance-card p {
          line-height: 1.25 !important;
        }
      }
    </style>
    <style id="budget-inline-layout">
      .budget-inline-intro {
        margin-bottom: 22px;
