      #budget .commercial-table thead th {
        padding: 11px 14px;
        background: #f5fbf9;
        border-bottom: 1px solid var(--line);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .11em;
        text-transform: uppercase;
        color: var(--muted);
      }
      #budget .commercial-table th:nth-child(1) { width: 5%; }
      #budget .commercial-table th:nth-child(2) { width: 28%; }
      #budget .commercial-table th:nth-child(3) { width: 52%; }
      #budget .commercial-table th:nth-child(4) { width: 15%; text-align: right; }
      #budget .commercial-table tbody td {
        padding: 12px 14px;
        border-bottom: 1px solid rgba(10,10,10,.08);
        font-size: 12px;
