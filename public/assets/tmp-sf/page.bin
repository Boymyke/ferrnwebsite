      }
      #budget .commercial-table tbody td:last-child strong { color: var(--navy); font-size: 13px; }
      #budget .commercial-table tbody tr:hover { background: #f8fcfb; }
      #budget .commercial-table .hipaa-row { background: linear-gradient(90deg, rgba(30,247,196,.12), rgba(15,138,106,.05)); }
      #budget .commercial-table .included-row {
        background: linear-gradient(90deg, rgba(30,247,196,.10), rgba(238,248,245,.72));
      }
