      }
      #work .project-link-btn:hover {
        color: #008a66 !important;
      }
      #work .ferrn-contact-card {
        background: #000 !important;
        border-color: rgba(255, 255, 255, 0.12) !important;
        margin-bottom: 0 !important;
      }
      #work .ferrn-contact-brand span {
        color: rgba(255, 255, 255, 0.66) !important;
      }
      #work .ferrn-contact-links {
        flex-wrap: wrap;
      }
      #work .website-contact,
      #work .email-contact {
        display: block;
      }
      #work .website-contact small,
      #work .website-contact strong,
      #work .email-contact small,
      #work .email-contact strong {
        display: block;
      }
      @media print {
        #work .title {
          font-size: 28pt !important;
        }
        #work .section-intro {
          margin-bottom: 12px !important;
        }
        #work .credentials {
          grid-template-columns: repeat(3, 1fr) !important;
          gap: 7px !important;
        }
        #work .cred {
          padding: 11px !important;
        }
        #work .cred b {
          font-size: 12px !important;
        }
        #work .cred p {
          font-size: 9px !important;
          line-height: 1.3 !important;
        }
        #work .project-link-btn {
          font-size: 9px !important;
          padding-top: 5px !important;
        }
        #work .ferrn-contact-card {
          margin-top: 9px !important;
          padding: 9px 11px !important;
        }
      }
    

      /* Splendid Freight contrast fixes */
      .dark .title span, .close-copy h2 span, .dark .display em { color: #1ef7c4 !important; }
      .launch-chip strong { color: #1ef7c4 !important; }
      .launch-chip span { color: rgba(255,255,255,.72) !important; }
      .budget-hero small, .budget-total-block small { color: rgba(255,255,255,.72) !important; }
      .commercial-table tr.group-row td { text-align: left !important; }
      .cred .project-link-btn { color: #1ef7c4 !important; border-color: rgba(30,247,196,.4) !important; }

      /* ── Splendid Freight: approach layout + realistic screens ── */
      #approach .method-grid { grid-template-columns: 1fr !important; gap: 26px !important; }
      #approach .steps { display: grid !important; grid-template-columns: repeat(5, 1fr); gap: 12px; }
      #approach .step { min-height: 0 !important; }
      #approach .demo-experience { width: 100%; }
      .sfui-fit { position: relative; width: 100%; overflow: hidden; }
      .sfui-fit > * { transform-origin: 0 0; width: 1240px; }
      .sfui-win { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,.35); font-family: Arial, Helvetica, sans-serif; color: #0f1714; text-align: left; }
      .sfui-win svg, .sfui-phone svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; flex: none; }
      .sfui-bar { height: 40px; display: flex; align-items: center; gap: 7px; padding: 0 14px; background: #eef1f0; border-bottom: 1px solid #dfe5e2; }
      .sfui-bar > i { width: 11px; height: 11px; border-radius: 50%; background: #d4dad7; }
      .sfui-bar > i:nth-child(1) { background: #ff5f57; } .sfui-bar > i:nth-child(2) { background: #febc2e; } .sfui-bar > i:nth-child(3) { background: #28c840; }
      .sfui-url { margin-left: 18px; display: flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #dfe5e2; border-radius: 8px; padding: 5px 12px; font-size: 12px; color: #5e6b66; width: 420px; }
      .sfui-url svg { width: 12px; height: 12px; }
      .sfui-app { display: grid; grid-template-columns: 184px 1fr 296px; min-height: 640px; }
      .sfui-side { background: #071f19; color: #cfe7df; padding: 18px 12px; display: flex; flex-direction: column; gap: 18px; }
      .sfui-brand { display: flex; align-items: center; gap: 9px; padding: 0 6px; }
      .sfui-brand svg { width: 26px !important; height: 26px !important; stroke: none !important; }
      .sfui-brand b { color: #fff; font-size: 16px; letter-spacing: -.01em; }
      .sfui-side nav { display: grid; gap: 2px; }
      .sfui-side nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; font-size: 13px; color: #b5cfc6; }
      .sfui-side nav a.on { background: rgba(30,247,196,.12); color: #fff; box-shadow: inset 2px 0 0 #1ef7c4; }
      .sfui-side nav a em { margin-left: auto; font-style: normal; font-size: 11px; background: rgba(255,255,255,.1); padding: 2px 7px; border-radius: 99px; color: #e6f5ef; }
      .sfui-side nav a.on em { background: #1ef7c4; color: #06261e; font-weight: 700; }
      .sfui-me { margin-top: auto; display: flex; align-items: center; gap: 9px; padding: 10px 6px 0; border-top: 1px solid rgba(255,255,255,.08); }
      .sfui-me > span { width: 30px; height: 30px; border-radius: 50%; background: #1ef7c4; color: #06261e; display: grid; place-items: center; font-size: 11px; font-weight: 800; }
      .sfui-me b { display: block; color: #fff; font-size: 12.5px; } .sfui-me small { color: #8fb3a7; font-size: 11px; }
      .sfui-main { padding: 18px 16px; background: #f6f8f7; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
      .sfui-top { display: flex; align-items: center; gap: 12px; }
      .sfui-top h4 { margin: 0; font-size: 20px; color: #0f1714; } .sfui-top small { font-size: 11.5px; color: #6b7873; }
      .sfui-search { margin-left: auto; display: flex; align-items: center; gap: 8px; width: 230px; padding: 8px 12px; white-space: nowrap; border: 1px solid #dfe5e2; border-radius: 8px; background: #fff; font-size: 12px; color: #8a9893; }
      .sfui-bell { position: relative; width: 34px; height: 34px; border: 1px solid #dfe5e2; border-radius: 8px; background: #fff; display: grid; place-items: center; color: #3d4a45; }
      .sfui-bell i { position: absolute; top: -5px; right: -5px; background: #e5484d; color: #fff; font-style: normal; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 99px; }
      .sfui-btn { white-space: nowrap; display: flex; align-items: center; gap: 6px; background: #007a5e; color: #fff; padding: 9px 13px; border-radius: 8px; font-size: 12.5px; font-weight: 700; }
      .sfui-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
      .sfui-stats div { background: #fff; border: 1px solid #e3e9e6; border-radius: 10px; padding: 11px 13px; }
      .sfui-stats small { display: block; font-size: 11.5px; color: #6b7873; }
      .sfui-stats b { display: block; font-size: 22px; margin: 3px 0 1px; color: #0f1714; }
      .sfui-stats span { font-size: 11px; color: #0f8a6a; }
      .sfui-stats .warn { border-color: #f5c7c2; background: #fff7f6; } .sfui-stats .warn span { color: #c2410c; }
      .sfui-filters { display: flex; align-items: center; gap: 6px; font-size: 12px; }
      .sfui-filters span { padding: 6px 11px; border-radius: 99px; color: #3d4a45; background: #fff; border: 1px solid #e3e9e6; }
      .sfui-filters span.on { background: #0a2a22; color: #fff; border-color: #0a2a22; }
      .sfui-filters i { flex: 1; } .sfui-filters .chip { border-style: dashed; }
      .sfui-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid #e3e9e6; border-radius: 10px; overflow: hidden; font-size: 12.5px; }
      .sfui-table th { text-align: left; font-weight: 600; color: #6b7873; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 9px 9px; background: #fafbfb; border-bottom: 1px solid #e3e9e6; }
      .sfui-table td { padding: 11px 9px; border-bottom: 1px solid #eef2f0; color: #26322e; white-space: nowrap; }
      .sfui-table tr:last-child td { border-bottom: 0; }
      .sfui-table tr.sel td { background: #effcf7; } .sfui-table tr.sel td:first-child { box-shadow: inset 3px 0 0 #00936d; }
      .pill { display: inline-block; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 99px; white-space: nowrap; }
      .pill.amber { background: #fff4db; color: #a15c00; } .pill.red { background: #fde8e7; color: #c0362c; } .pill.teal { background: #defbf1; color: #00785b; }
      .pill.grey { background: #eef1f0; color: #4b5753; } .pill.blue { background: #e5f0ff; color: #1d5fc2; }
      .sfui-detail { border-left: 1px solid #e3e9e6; padding: 18px; display: flex; flex-direction: column; gap: 14px; background: #fff; }
      .sfui-dhead { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
      .sfui-dhead small { font-size: 10.5px; letter-spacing: .06em; color: #0f8a6a; font-weight: 700; }
      .sfui-dhead h5 { margin: 3px 0 2px; font-size: 16px; } .sfui-dhead p { margin: 0; font-size: 11.5px; color: #6b7873; }
      .sfui-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 10px; background: #f6f8f7; border-radius: 8px; }
      .sfui-meta small { display: block; font-size: 10px; color: #6b7873; text-transform: uppercase; letter-spacing: .04em; } .sfui-meta b { font-size: 11px; }
      .sfui-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
      .sfui-steps li { position: relative; padding: 0 0 12px 24px; font-size: 12px; }
      .sfui-steps li::before { content: ""; position: absolute; left: 4px; top: 3px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid #cfd8d4; background: #fff; }
      .sfui-steps li::after { content: ""; position: absolute; left: 9px; top: 16px; bottom: -2px; width: 2px; background: #e3e9e6; }
      .sfui-steps li:last-child::after { display: none; }
      .sfui-steps li.done::before { background: #00936d; border-color: #00936d; } .sfui-steps li.done::after { background: #00936d; }
      .sfui-steps li.now::before { border-color: #e59b00; background: #fff4db; box-shadow: 0 0 0 4px rgba(229,155,0,.15); }
      .sfui-steps b { display: block; color: #26322e; font-weight: 600; } .sfui-steps li:not(.done):not(.now) b { color: #8a9893; font-weight: 400; }
      .sfui-steps small { font-size: 11px; color: #6b7873; }
      .sfui-form { margin-top: auto; border: 1px solid #cdeee2; background: #f3fdf9; border-radius: 10px; padding: 12px; display: grid; gap: 8px; font-size: 12px; }
      .sfui-form > b { font-size: 12.5px; }
      .sfui-select, .sfui-note { background: #fff; border: 1px solid #d5ded9; border-radius: 7px; padding: 8px 10px; color: #26322e; }
      .sfui-select { display: flex; justify-content: space-between; align-items: center; font-weight: 600; border-color: #00936d; box-shadow: 0 0 0 3px rgba(0,147,109,.12); }
      .sfui-note { min-height: 46px; color: #4b5753; line-height: 1.4; }
      .sfui-form label { display: flex; gap: 7px; align-items: center; color: #26322e; }
      .sfui-form .box { width: 16px; height: 16px; border-radius: 4px; background: #00936d; color: #fff; display: grid; place-items: center; }
      .sfui-form .box svg { width: 11px; height: 11px; stroke-width: 3; }
      .sfui-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .sfui-actions span { display: flex; align-items: center; gap: 5px; padding: 8px 12px; border-radius: 7px; font-weight: 700; }
      .sfui-actions .ghost { border: 1px solid #d5ded9; background: #fff; color: #3d4a45; } .sfui-actions .primary { background: #007a5e; color: #fff; }
      .sfui-mobile .phone-screen.sfui-phone { background: #f4f7f6 !important; padding: 34px 12px 14px !important; display: flex; flex-direction: column; gap: 10px; color: #0f1714; text-align: left; overflow: hidden; }
      .sfp-top { display: flex; align-items: center; gap: 7px; font-size: 13px; }
      .sfp-top svg { width: 20px !important; height: 20px !important; stroke: none !important; }
      .sfp-top span { margin-left: auto; font-size: 11px; color: #6b7873; }
      .sfp-card { background: #0a2a22; color: #fff; border-radius: 14px; padding: 13px; }
      .sfp-card small { font-size: 9.5px; letter-spacing: .08em; color: #1ef7c4; font-weight: 700; }
      .sfp-card h4 { margin: 4px 0 2px; font-size: 18px; color: #fff; } .sfp-card p { margin: 0; font-size: 10.5px; color: rgba(255,255,255,.7); }
      .sfp-bar { height: 5px; border-radius: 99px; background: rgba(255,255,255,.15); margin: 10px 0; } .sfp-bar i { display: block; height: 100%; border-radius: 99px; background: #1ef7c4; }
      .sfp-route { display: flex; align-items: center; justify-content: space-between; font-size: 11px; } .sfp-route small { display: block; color: rgba(255,255,255,.6); font-size: 9.5px; } .sfp-route span { color: #1ef7c4; }
      .sfp-eta { margin-top: 9px; padding-top: 9px; border-top: 1px solid rgba(255,255,255,.12); font-size: 11px; } .sfp-eta small { display: block; color: rgba(255,255,255,.6); font-size: 9.5px; }
      .sfp-list { background: #fff; border-radius: 12px; padding: 10px 12px; display: grid; gap: 8px; }
      .sfp-list div { display: flex; gap: 9px; align-items: flex-start; } .sfp-list i { width: 8px; height: 8px; margin-top: 4px; border-radius: 50%; background: #00936d; flex: none; }
      .sfp-list .now i { background: #1ef7c4; box-shadow: 0 0 0 3px rgba(30,247,196,.3); }
      .sfp-list p { margin: 0; } .sfp-list b { display: block; font-size: 11.5px; } .sfp-list small { font-size: 10px; color: #6b7873; }
      .sfp-docs { display: flex; gap: 6px; flex-wrap: wrap; } .sfp-docs span { font-size: 10px; background: #fff; border: 1px solid #e3e9e6; border-radius: 6px; padding: 5px 7px; color: #26322e; }
      .sfp-cta { margin-top: auto; text-align: center; background: #25d366; color: #06261e; font-weight: 800; font-size: 12px; border-radius: 10px; padding: 10px; }

      /* ── side-by-side tick table ── */
      .sf-cmp-wrap { margin-top: 34px; border: 1px solid #dfe9e5; border-radius: 24px; background: #fff; box-shadow: 0 18px 50px rgba(10,42,34,.07); overflow-x: auto; }
      .sf-cmp { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14.5px; min-width: 760px; }
      .sf-cmp thead th { vertical-align: bottom; text-align: center; padding: 40px 14px 18px; border-bottom: 1px solid #e6ece9; background: #fff; position: relative; }
      .sf-cmp thead th small { display: block; font-size: 11.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #0f8a6a; }
      .sf-cmp thead th b { display: block; font-size: 20px; color: #0a0f0d; margin: 4px 0; letter-spacing: -.01em; }
      .sf-cmp thead th span { display: block; font-size: 26px; font-weight: 800; color: #0a2a22; letter-spacing: -.02em; }
      .sf-cmp thead th i { display: block; font-style: normal; font-size: 12.5px; color: #5e6b66; margin-top: 4px; font-weight: 400; }
      .sf-cmp thead th em { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); font-style: normal; background: #1ef7c4; color: #06261e; font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 99px; white-space: nowrap; }
      .sf-cmp .sf-cmp-corner { text-align: left; width: 34%; }
      .sf-cmp .sf-cmp-corner b { font-size: 18px; }
      .sf-cmp tbody th { text-align: left; font-weight: 600; color: #26322e; padding: 13px 20px; border-bottom: 1px solid #eef2f0; }
      .sf-cmp tbody td, .sf-cmp tfoot td { text-align: center; padding: 13px 12px; border-bottom: 1px solid #eef2f0; width: 22%; }
      .sf-cmp .c1 { background: #f2fcf8; }
      .sf-cmp thead th.c1 { background: #0a2a22; } .sf-cmp thead th.c1 small, .sf-cmp thead th.c1 span { color: #1ef7c4; } .sf-cmp thead th.c1 b { color: #fff; } .sf-cmp thead th.c1 i { color: rgba(255,255,255,.7); }
      .sf-cmp-group th { background: #f4f7f6 !important; color: #0f8a6a !important; font-size: 12px !important; letter-spacing: .08em; text-transform: uppercase; font-weight: 800 !important; padding: 10px 20px !important; }
      .sf-yes { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #00936d; color: #fff; }
      .sf-yes svg { width: 15px; height: 15px; }
      .sf-no { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #eef1f0; color: #a3aeaa; }
      .sf-txt { font-size: 13.5px; font-weight: 700; color: #0a2a22; }
      .sf-cmp tfoot th { text-align: left; padding: 13px 20px; color: #26322e; font-weight: 600; border-bottom: 1px solid #eef2f0; }
      .sf-cmp tfoot td { font-weight: 600; color: #26322e; }
      .sf-cmp-total th, .sf-cmp-total td { background: #0a2a22 !important; color: #fff !important; border: 0 !important; }
      .sf-cmp-total td b { color: #1ef7c4; font-size: 19px; }
      .sf-cmp-links td { border-bottom: 0 !important; padding: 16px 10px 22px !important; }
      .sf-cmp-links th { border-bottom: 0 !important; }
      .sf-cmp-links a { display: inline-block; padding: 9px 14px; border-radius: 99px; border: 1px solid #00936d; color: #007a5e; font-weight: 700; font-size: 13px; text-decoration: none; }
      .sf-cmp-links .c1 a { background: #007a5e; color: #fff; }
      .sf-every-note { margin-top: 16px; font-size: 14px; color: #5e6b66; }

      /* ── per-option breakdown ── */
      .sf-opt-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 30px; }
      .sf-opt-tab { text-align: left; border: 1px solid #cfe6dd; background: #fff; border-radius: 18px; padding: 16px 18px; cursor: pointer; font: inherit; color: #0a0f0d; }
      .sf-opt-tab small { display: block; font-size: 11.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #0f8a6a; }
      .sf-opt-tab b { display: block; font-size: 18px; margin: 3px 0; } .sf-opt-tab span { font-size: 16px; font-weight: 800; color: #0a2a22; }
      .sf-opt-tab.active { background: #0a2a22; border-color: #0a2a22; color: #fff; box-shadow: 0 16px 40px rgba(10,42,34,.2); }
      .sf-opt-tab.active small, .sf-opt-tab.active span { color: #1ef7c4; }
      .sf-block { margin-top: 20px; background: #fff; border: 1px solid #dfe9e5; border-radius: 24px; overflow: hidden; box-shadow: 0 18px 50px rgba(10,42,34,.06); scroll-margin-top: 90px; }
      .sf-block-head { display: flex; justify-content: space-between; gap: 20px; align-items: flex-end; padding: 24px 24px 18px; }
      .sf-block-head small { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #0f8a6a; }
      .sf-block-head h3 { margin: 6px 0 4px; font-size: 26px; letter-spacing: -.02em; color: #0a0f0d; }
      .sf-block-head p { margin: 0; font-size: 14px; color: #5e6b66; max-width: 680px; }
      .sf-block-head p.sf-meta { margin-top: 6px; color: #0a2a22; font-weight: 600; font-size: 13px; }
      .sf-block-total { text-align: right; flex: none; }
      .sf-block-total span { display: block; font-size: 12px; color: #5e6b66; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; }
      .sf-block-total strong { white-space: nowrap; font-size: 28px; color: #0a2a22; letter-spacing: -.02em; }
      .sf-block-total em { display: block; font-style: normal; font-size: 12.5px; color: #5e6b66; margin-top: 2px; }
      .sf-table-wrap { overflow-x: auto; }
      .sf-table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .sf-table th { text-align: left; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: #5e6b66; padding: 12px 16px; background: #f4f7f6; border-top: 1px solid #e6ece9; border-bottom: 1px solid #e6ece9; }
      .sf-table td { padding: 14px 16px; border-bottom: 1px solid #eef2f0; vertical-align: top; color: #3d4a45; line-height: 1.5; }
      .sf-table td:first-child { color: #0f8a6a; font-weight: 800; width: 42px; }
      .sf-table td b { display: block; color: #0a0f0d; font-size: 14.5px; margin-bottom: 3px; }
      .sf-table td span { display: block; color: #5e6b66; font-size: 13.5px; }
      .sf-table td:nth-child(3) { color: #0a2a22; }
      .sf-table th:last-child, .sf-table td:last-child { text-align: right; white-space: nowrap; }
      .sf-table td strong { color: #0a2a22; }
      .sf-table tfoot td { background: #0a2a22; color: #fff; border: 0; padding: 16px; }
      .sf-table tfoot td b { color: #fff; margin: 0; } .sf-table tfoot td strong { color: #1ef7c4; font-size: 18px; }
      .sf-web { margin-top: 26px; }
      .sf-web-table td:first-child { width: auto; color: #3d4a45; font-weight: 400; }
      .sf-web s, .sf-web-table s { color: #8a9893; font-weight: 600; }
      .sf-web-table em { font-style: normal; color: #1ef7c4; font-weight: 800; margin-left: 6px; } .sf-web-table tfoot s { color: rgba(255,255,255,.55); }
      .sf-free-pill { font-style: normal; background: #1ef7c4; color: #06261e; padding: 3px 10px; border-radius: 999px; font-size: 16px; vertical-align: middle; margin-left: 6px; }
      .sf-free { margin-top: 26px; padding: 24px; border-radius: 24px; background: #0a2a22; color: #fff; }
      .sf-free > small { font-size: 12px; font-weight: 800; letter-spacing: .08em; color: #1ef7c4; }
      .sf-free-grid { margin-top: 14px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .sf-free-grid div { padding: 14px 16px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); }
      .sf-free-grid b { display: block; font-size: 15px; } .sf-free-grid span { display: block; margin-top: 4px; font-size: 13px; color: rgba(255,255,255,.7); line-height: 1.45; }
      .sf-maint { margin-top: 26px; padding: 24px; border-radius: 24px; background: #fff; border: 1px solid #dfe9e5; }
      .sf-maint-head small { font-size: 12px; font-weight: 800; letter-spacing: .08em; color: #0f8a6a; }
      .sf-maint-head h3 { margin: 6px 0 4px; font-size: 24px; color: #0a0f0d; } .sf-maint-head p { margin: 0; font-size: 14px; color: #5e6b66; max-width: 760px; }
      .sf-maint-grid { margin-top: 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .sf-maint-grid div { padding: 16px 18px; border-radius: 16px; border: 1px solid #dfe9e5; background: #f6fdfa; }
      .sf-maint-grid div.featured { background: #0a2a22; border-color: #0a2a22; color: #fff; }
      .sf-maint-grid small { display: block; font-size: 12px; font-weight: 700; color: #0f8a6a; } .sf-maint-grid .featured small { color: #1ef7c4; }
      .sf-maint-grid strong { display: block; font-size: 26px; margin: 6px 0 0; color: #0a2a22; } .sf-maint-grid .featured strong { color: #fff; }
      .sf-maint-grid span { font-size: 13px; color: #5e6b66; } .sf-maint-grid .featured span { color: rgba(255,255,255,.7); }
      .sf-maint-grid em { display: block; font-style: normal; font-size: 12.5px; color: #3d4a45; margin-top: 8px; } .sf-maint-grid .featured em { color: rgba(255,255,255,.8); }
      .sf-pay-table td:first-child { width: auto; color: #0a0f0d; font-weight: 400; }
      .sf-pay-table td, .sf-pay-table th { text-align: right; } .sf-pay-table td:first-child, .sf-pay-table th:first-child { text-align: left; }
      #scope .delivery-timeline { margin-top: 30px; }

      @media (max-width: 980px) {
        #approach .steps { grid-template-columns: 1fr 1fr; }
        .sf-free-grid, .sf-maint-grid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 640px) {
        #approach .steps { grid-template-columns: 1fr; }
        .sf-cmp { min-width: 0; font-size: 12.5px; }
        .sf-cmp .sf-cmp-corner { width: 40%; padding-left: 12px; } .sf-cmp .sf-cmp-corner b { font-size: 13px; } .sf-cmp .sf-cmp-corner small { display: none; }
        .sf-cmp thead th { padding: 30px 4px 12px; }
        .sf-cmp thead th b { font-size: 12.5px; } .sf-cmp thead th span { font-size: 13px; } .sf-cmp thead th i { display: none; } .sf-cmp thead th small { font-size: 9.5px; letter-spacing: .04em; }
        .sf-cmp thead th em { font-size: 9px; padding: 2px 6px; }
        .sf-cmp tbody th, .sf-cmp tfoot th { padding: 10px 8px 10px 12px; font-size: 12px; }
        .sf-cmp tbody td, .sf-cmp tfoot td { padding: 10px 3px; width: auto; }
        .sf-cmp-group th { padding: 8px 12px !important; font-size: 10.5px !important; }
        .sf-yes, .sf-no { width: 22px; height: 22px; } .sf-txt { font-size: 11px; }
        .sf-cmp-total td b { font-size: 12.5px; }
        .sf-cmp tfoot td { font-size: 11px; }
        .sf-cmp-links a { padding: 6px 7px; font-size: 10.5px; }
        .sf-opt-tabs { grid-template-columns: 1fr; gap: 8px; }
        .sf-opt-tab { padding: 12px 14px; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
        .sf-opt-tab b { font-size: 16px; margin: 0; } .sf-opt-tab span { margin-left: auto; font-size: 15px; }
        .sf-block-head { flex-direction: column; align-items: flex-start; padding: 20px 16px 14px; }
        .sf-block-total { text-align: left; }
        .sf-free-grid, .sf-maint-grid { grid-template-columns: 1fr; }
        .sf-table thead { display: none; }
        .sf-table:not(.sf-pay-table) tr { display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; padding: 14px 16px; border-bottom: 1px solid #eef2f0; }
        .sf-table:not(.sf-pay-table) td { padding: 0; border: 0; text-align: left !important; }
        .sf-table:not(.sf-pay-table) tbody td:nth-child(3) { grid-column: 2; font-size: 13.5px; }
        .sf-table:not(.sf-pay-table) tbody td:nth-child(4) { grid-column: 2; }
        .sf-web-table tbody td:nth-child(2) { grid-column: 1 / -1; }
        .sf-table:not(.sf-pay-table) tfoot tr { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: #0a2a22; }
        .sf-table:not(.sf-pay-table) tfoot td { padding: 0; background: transparent; }
        .sf-table tfoot td:first-child { width: auto; }
        .sf-pay-table { font-size: 12px; } .sf-pay-table td, .sf-pay-table th { padding: 10px 6px; }
        #scope .delivery-table, #scope .delivery-table tbody { display: block; width: 100%; min-width: 0 !important; }
        #scope .delivery-table thead { display: none; }
        #scope .delivery-table tr { display: block; padding: 14px 4px; border-bottom: 1px solid rgba(255,255,255,.1); }
        #scope .delivery-table td { display: block; padding: 3px 0 !important; border: 0 !important; width: auto !important; }
        #scope .delivery-table td:nth-child(2) { color: #1ef7c4; font-weight: 700; font-size: 13px; }
      }

      .sfui-top > div:first-child { white-space: nowrap; }
      @media (max-width: 640px) { .sf-cmp thead th { padding-top: 34px; } }

      .sf-cmp tbody th b { display: block; font-size: 14.5px; color: #0a0f0d; font-weight: 700; }
      .sf-cmp tbody th span { display: block; margin-top: 3px; font-size: 13px; line-height: 1.45; color: #5e6b66; font-weight: 400; }
      .sf-cmp tbody td { vertical-align: middle; }
      @media (max-width: 640px) { .sf-cmp tbody th b { font-size: 12px; } .sf-cmp tbody th span { font-size: 11px; } }

      .problem-main .truth small { display: block !important; color: #1ef7c4 !important; opacity: 1 !important; font-size: 12px !important; font-weight: 800 !important; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px; visibility: visible !important; }
      .problem-main .truth strong { color: #fff !important; }

      /* ── 01 approach flow ── */
      .sf-flow { margin-top: 34px; display: grid; gap: 0; }
      .sf-lane { border-radius: 24px; padding: 26px 24px 22px; }
      .sf-lane-now { background: #fff; border: 1px solid #e3e9e6; }
      .sf-lane-next { background: linear-gradient(150deg, #071f19, #0a3a2e); color: #fff; box-shadow: 0 26px 60px rgba(10,42,34,.22); }
      .sf-lane-head small { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #8a5a00; }
      .sf-lane-next .sf-lane-head small { color: #1ef7c4; }
      .sf-lane-head h3 { margin: 6px 0 0; font-size: 24px; letter-spacing: -.02em; color: #0a0f0d; }
      .sf-lane-next .sf-lane-head h3 { color: #fff; }
      .sf-track { margin-top: 20px; display: flex; align-items: stretch; gap: 0; }
      .sf-node { flex: 1 1 0; min-width: 0; border-radius: 16px; padding: 14px 12px; display: flex; flex-direction: column; gap: 4px; }
      .sf-node span { font-size: 11px; font-weight: 800; letter-spacing: .06em; }
      .sf-node b { font-size: 14.5px; line-height: 1.25; }
      .sf-node small { font-size: 12.5px; line-height: 1.4; }
      .sf-node.now { background: #f4f6f5; border: 1px dashed #c9d2ce; color: #26322e; }
      .sf-node.now span { color: #8a9893; } .sf-node.now small { color: #6b7873; }
      .sf-node.next { background: rgba(255,255,255,.07); border: 1px solid rgba(30,247,196,.28); color: #fff; }
      .sf-node.next span { color: #1ef7c4; } .sf-node.next small { color: rgba(255,255,255,.72); }
      .sf-flow-arrow { flex: none; width: 22px; display: grid; place-items: center; }
      .sf-flow-arrow svg { width: 16px; height: 16px; fill: none; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
      .sf-lane-now .sf-flow-arrow svg { stroke: #b4bfbb; } .sf-lane-next .sf-flow-arrow svg { stroke: #1ef7c4; }
      .sf-notes { margin-top: 18px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
      .sf-notes div { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 14px; }
      .sf-notes i { flex: none; width: 10px; height: 10px; border-radius: 50%; margin-top: 4px; }
      .sf-notes p { margin: 0; font-size: 13px; line-height: 1.45; }
      .sf-notes b { display: block; font-size: 14px; margin-bottom: 2px; }
      .sf-notes .bad { background: #fff6f5; border: 1px solid #f6d3cf; color: #5e3a36; } .sf-notes .bad i { background: #e5484d; } .sf-notes .bad b { color: #9b2c25; }
      .sf-notes .good { background: rgba(30,247,196,.08); border: 1px solid rgba(30,247,196,.25); color: rgba(255,255,255,.78); } .sf-notes .good i { background: #1ef7c4; } .sf-notes .good b { color: #fff; }
      .sf-bridge { display: grid; place-items: center; padding: 14px 0; position: relative; }
      .sf-bridge::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; background: linear-gradient(#c9d2ce, #00936d); }
      .sf-bridge span { position: relative; display: flex; align-items: center; gap: 8px; background: #1ef7c4; color: #06261e; font-weight: 800; font-size: 13px; padding: 9px 16px; border-radius: 999px; box-shadow: 0 10px 30px rgba(0,147,109,.3); }
      .sf-bridge svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
      @media (max-width: 1100px) {
        .sf-track { flex-wrap: wrap; gap: 10px 0; }
        .sf-node { flex: 1 1 calc(25% - 22px); }
        .sf-notes { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 640px) {
        .sf-lane { padding: 20px 16px; }
        .sf-lane-head h3 { font-size: 20px; }
        .sf-track { flex-direction: column; gap: 0; }
        .sf-node { flex: none; flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; padding: 12px 14px; }
        .sf-node small { flex-basis: 100%; padding-left: 28px; }
        .sf-flow-arrow { width: 100%; height: 20px; }
        .sf-flow-arrow svg { transform: rotate(90deg); }
        .sf-notes { grid-template-columns: 1fr; }
      }
      .sf-hero-logo { display:flex; align-items:center; gap:14px; margin-bottom:24px; }
      .sf-hero-logo svg { width:52px; height:52px; flex:none; }
      .sf-hero-logo span { font-size:30px; font-weight:800; letter-spacing:-0.02em; color:#0a0f0d; }
      .chip.dark-chip { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.16); color:#fff; }
      .prototype-note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
      @media (max-width: 640px) { .sf-hero-logo span { font-size:24px; } .sf-hero-logo svg { width:42px; height:42px; } }
      .commercial-table tr.group-row td { background: #0a2a22; color: #fff; padding: 14px 18px; font-size: 14px; }
      .commercial-table tr.group-row td b { color: #1ef7c4; font-weight: 800; }
    </style>
</head>
<body>
    <header class="topbar">
      <div class="agency">
        <span class="ferrn"><svg aria-hidden="true" fill="none" viewbox="0 0 478 478" xmlns="http://www.w3.org/2000/svg"><rect fill="black" height="478" width="478"></rect><path d="M320.71 157.291V320.71H157.291V266.355H264.499V210.193H174.294V157.291H320.71Z" fill="#FF4100"></path></svg></span
        ><span class="agency-copy"
          ><b>Ferrn Creative Agency</b
          ><span>Proposal prepared for Splendid Freight International Ltd</span></span
        >
      </div>
      <div class="top-actions">
        <button class="btn primary" onclick="document.getElementById('options').scrollIntoView({ behavior: 'smooth' })">
          See the options <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button
        ><a class="btn secondary" download="" href="Splendid-Freight-Proposal.pdf">Download PDF <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg></a>
      </div>
    </header>

    <section class="proposal-page white" id="top">
      <div class="shell">
        <div class="hero-grid">
          <div>
            <div class="sf-hero-logo"><svg viewBox="0 0 40 40" aria-label="Splendid Freight" role="img"><defs><mask id="sfm"><rect width="40" height="40" fill="#fff"/><path d="M14 1.5C8 7.5 8.6 14.2 16.4 18.6C24.2 23 28.4 28.6 24.6 38.6" fill="none" stroke="#000" stroke-width="3.6" stroke-linecap="round"/></mask></defs><circle cx="20" cy="20" r="19" fill="#1EF7C4" mask="url(#sfm)"/><circle cx="20" cy="20" r="19" fill="none" stroke="#007a5e" stroke-opacity=".25" stroke-width="1" /></svg><span>Splendid Freight</span></div>
            <span class="eyebrow"><i></i> Logistics &amp; ATM support platform proposal</span>
            <h1 class="display">Every shipment, visible to <em>every customer.</em></h1>
            <p class="lead" style="margin-top: 26px">
              One system for freight and ATM jobs. Your team updates it, your customers see it,
              and you see where time and money go.
            </p>
          </div>
          <div aria-label="Cargo port operations" class="hero-photo">
            <div class="hero-card">
              <small>Built around Splendid Freight's operations</small>
              <h3>Freight, customs and ATM jobs, tracked in one place.</h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="proposal-page mint" id="understanding">
      <div class="shell">
        <div class="page-head section-label-only">
          <span class="section-no">01 · Our approach</span>
        </div>
        <div class="section-intro">
          <div>
            <h2 class="title">From chasing updates to <span>one shared record.</span></h2>
          </div>
          <p class="lead">
            Today, a shipment lives in Outlook, Zoho Books and phone calls. Customers chase
            updates, and delays are found late.
          </p>
        </div>
        <div class="sf-flow">
          <div class="sf-lane sf-lane-now">
            <div class="sf-lane-head"><small>Your process today</small><h3>Email, spreadsheets and phone calls</h3></div>
            <div class="sf-track"><div class="sf-node now"><span>01</span><b>Request by email</b><small>Weight, size, goods and pickup address</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node now"><span>02</span><b>Quote by email</b><small>Priced and sent from Outlook</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node now"><span>03</span><b>Approval by email</b><small>Customer replies to confirm</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node now"><span>04</span><b>Invoice in Zoho</b><small>Typed in by hand</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node now"><span>05</span><b>Pickup and freight</b><small>Air, ocean or road</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node now"><span>06</span><b>Customs</b><small>PAAR, duty, examination, release</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node now"><span>07</span><b>Delivery</b><small>Inland truck to the door</small></div></div>
            <div class="sf-notes">
              <div class="bad"><i></i><p><b>Back and forth over email</b>Quotes and approvals sit in inboxes.</p></div>
              <div class="bad"><i></i><p><b>"Any update?" calls</b>Customers cannot see where their cargo is.</p></div>
              <div class="bad"><i></i><p><b>Delays found late</b>A held PAAR shows up when the customer calls.</p></div>
              <div class="bad"><i></i><p><b>ATM jobs off the record</b>Machines and sign-offs live in photos and sheets.</p></div>
            </div>
          </div>
          <div class="sf-bridge" aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></svg>Where we take you</span></div>
          <div class="sf-lane sf-lane-next">
            <div class="sf-lane-head"><small>With your new platform</small><h3>One record your team and customers share</h3></div>
            <div class="sf-track"><div class="sf-node next"><span>01</span><b>Request in the portal</b><small>A simple form or account</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node next"><span>02</span><b>Quote accepted online</b><small>One click to approve</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node next"><span>03</span><b>Invoice synced</b><small>Straight to Zoho Books</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node next"><span>04</span><b>Team updates the step</b><small>Pick the step, add a note, save</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node next"><span>05</span><b>Customer sees it live</b><small>Tracking page, email and WhatsApp</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node next"><span>06</span><b>Delays flagged early</b><small>Before the customer asks</small></div><span class="sf-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><div class="sf-node next"><span>07</span><b>Reports</b><small>Days, costs and profit per job</small></div></div>
            <div class="sf-notes">
              <div class="good"><i></i><p><b>No email chasing</b>Requests, quotes and invoices flow on their own.</p></div>
              <div class="good"><i></i><p><b>Fewer calls</b>Customers see every step the moment you save it.</p></div>
              <div class="good"><i></i><p><b>Delays handled early</b>Late steps alert your team first.</p></div>
              <div class="good"><i></i><p><b>ATM jobs on record</b>Every machine, part and sign-off in one place.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="proposal-page dark" id="approach">
      <div class="shell">
        <div class="page-head section-label-only">
          <span class="section-no">02 · How it works</span>
        </div>
        <div class="section-intro">
          <div>
            <h2 class="title">Update once. <span>Everyone sees it.</span></h2>
          </div>
          <p class="lead">
            Your team updates a shipment's status in the portal. The customer's tracking page,
            messages and reports update on their own.
          </p>
        </div>
        <div class="method-grid">
          <div class="steps">
            <div class="step"><span>01</span><div><b>Discover</b><p>Workshops in Lagos and Abuja.</p></div></div>
            <div class="step"><span>02</span><div><b>Design</b><p>Screens approved before we build.</p></div></div>
            <div class="step"><span>03</span><div><b>Build</b><p>Weekly progress you can click through.</p></div></div>
            <div class="step"><span>04</span><div><b>Pilot</b><p>Real shipments with your team.</p></div></div>
            <div class="step"><span>05</span><div><b>Launch</b><p>Data moved, team trained.</p></div></div>
          </div>
          <div>
            <div aria-label="Splendid Freight portal preview" class="demo-experience">
              <div aria-label="Screens" class="demo-tabs" role="tablist">
                <button aria-selected="true" class="demo-tab active" data-demo-tab="desktop" role="tab" type="button">
                  <span>01</span><div><b>Operations portal</b><small>Your team updates a shipment</small></div>
                </button>
                <button aria-selected="false" class="demo-tab" data-demo-tab="mobile" role="tab" type="button">
                  <span>02</span><div><b>Customer tracking</b><small>What the customer sees</small></div>
                </button>
              </div>
              <div class="demo-panel active" data-demo-panel="desktop">
                <div class="sfui-fit" data-w="1240"><div class="sfui-win">
                  <div class="sfui-bar"><i></i><i></i><i></i><span class="sfui-url"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>portal.splendidfreight.com/shipments</span></div>
                  <div class="sfui-app">
                    <aside class="sfui-side">
                      <div class="sfui-brand"><svg viewBox="0 0 40 40" aria-label="Splendid Freight" role="img"><defs><mask id="sfma"><rect width="40" height="40" fill="#fff"/><path d="M14 1.5C8 7.5 8.6 14.2 16.4 18.6C24.2 23 28.4 28.6 24.6 38.6" fill="none" stroke="#000" stroke-width="3.6" stroke-linecap="round"/></mask></defs><circle cx="20" cy="20" r="19" fill="#1EF7C4" mask="url(#sfma)"/><circle cx="20" cy="20" r="19" fill="none" stroke="#007a5e" stroke-opacity=".25" stroke-width="1" /></svg><b>Splendid</b></div>
                      <nav>
                        <a><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Overview</a>
                        <a class="on"><svg viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>Shipments<em>58</em></a>
                        <a><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg>Customs<em>9</em></a>
                        <a><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>ATM jobs<em>7</em></a>
                        <a><svg viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M2 21v-1a6 6 0 0 1 12 0v1"/><path d="M16 3.5a4 4 0 0 1 0 7"/><path d="M22 21v-1a6 6 0 0 0-4-5.6"/></svg>Customers</a>
                        <a><svg viewBox="0 0 24 24"><path d="M5 2v20l3-2 3 2 3-2 3 2 2-1.5V2z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>Invoices</a>
                        <a><svg viewBox="0 0 24 24"><path d="M3 7h18v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 7l2-4h14l2 4"/><circle cx="16" cy="14" r="1.5"/></svg>Expenses</a>
                        <a><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 16v-5M12 16V8M17 16v-8"/></svg>Reports</a>
                        <a><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg>Website</a>
                      </nav>
                      <div class="sfui-me"><span>MD</span><div><b>Meshack D.</b><small>Operations · Lagos</small></div></div>
                    </aside>
                    <main class="sfui-main">
                      <div class="sfui-top">
                        <div><h4>Shipments</h4><small>12 Nov · All branches</small></div>
