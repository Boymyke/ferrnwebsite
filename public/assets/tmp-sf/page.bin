        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      #budget .commercial-table tfoot td {
        padding: 15px 14px;
        background: var(--navy2);
        color: #fff;
      }
      #budget .commercial-table tfoot td b,
      #budget .commercial-table tfoot td span { display: block; }
      #budget .commercial-table tfoot td b { font-size: 13px; }
      #budget .commercial-table tfoot td span { margin-top: 2px; font-size: 10px; color: rgba(255,255,255,.6); }
      #budget .commercial-table tfoot td:last-child { text-align: right; white-space: nowrap; }
      #budget .commercial-table tfoot strong { font-size: 17px; color: var(--aqua); }
      #budget .compliance-note,
      #budget .usage-note {
        margin: 0;
        padding: 12px 16px;
        font-size: 10px;
        line-height: 1.45;
        color: var(--muted);
        background: #fbfcfc;
      }
      #budget .compliance-note { border-top: 1px solid var(--line); }
      #budget .complimentary-services {
        margin-top: 0 !important;
        padding: 0 0 16px !important;
        background: linear-gradient(145deg, #f3fbfa, #e8fbf6) !important;
        border-radius: 24px !important;
      }
      #budget .free-badge {
        flex: 0 0 auto;
        width: 94px;
        height: 94px;
        border-radius: 50%;
        display: grid;
        place-content: center;
        text-align: center;
        background: var(--navy2);
        color: #fff;
      }
      #budget .free-badge strong { display: block; font-size: 30px; line-height: 1; color: var(--aqua); }
      #budget .free-badge span { display: block; margin-top: 4px; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.65); }
      #budget .complimentary-services .third-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        gap: 10px !important;
        padding: 0 16px;
      }
      #budget .complimentary-services .third {
        min-height: 145px;
        padding: 16px !important;
        border: 1px solid rgba(0,122,94,.09);
        box-shadow: 0 12px 26px rgba(10,42,34,.05);
      }
      #budget .included-label {
        display: inline-flex !important;
        width: fit-content;
        margin-bottom: 9px;
        padding: 5px 7px;
        border-radius: 999px;
        background: rgba(30,247,196,.16);
        color: var(--navy) !important;
        font-size: 9px !important;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      #budget .complimentary-services .third b { font-size: 13px; }
      #budget .complimentary-services .third > span:last-child { font-size: 12px; line-height: 1.45; }
      #budget .usage-note { margin: 10px 0 0; border-radius: 10px; background: rgba(255,255,255,.82); border: 1px solid rgba(10,10,10,.08); }
      #budget .maintenance-card { margin: 14px 0 0 !important; }

      @media (max-width: 900px) {
        #budget .budget-hero { gap: 16px !important; padding: 22px !important; }
        #budget .commercial-head,
        #budget .complimentary-head { align-items: flex-start; flex-direction: column; gap: 14px; padding: 20px; }
        #budget .commercial-total { text-align: left; min-width: 0; width: 100%; }
        #budget .complimentary-services .third-grid { grid-template-columns: repeat(2, minmax(0,1fr)) !important; }
        #budget .free-badge { width: 76px; height: 76px; }
      }
      @media (max-width: 620px) {
        #budget .pay { grid-template-columns: 1fr !important; }
        #budget .complimentary-services .third-grid { grid-template-columns: 1fr !important; }
        #budget .price { font-size: clamp(42px, 14vw, 62px) !important; }
      }

      @media print {
        /* Let the expanded one-column budget flow naturally across PDF pages. */
        #budget { height: auto !important; min-height: 0 !important; overflow: visible !important; page-break-after: always; }
        #budget .shell { width: auto !important; margin: 0 10mm !important; }
        #budget .budget-layout {
          position: static !important;
          left: auto !important;
          right: auto !important;
          top: auto !important;
          width: 100% !important;
          transform: none !important;
          display: flex !important;
          flex-direction: column !important;
          gap: 5mm !important;
          margin: 0 !important;
        }
        #budget .budget-hero {
          display: grid !important;
          grid-template-columns: 1.25fr .75fr !important;
          min-height: 0 !important;
          height: auto !important;
          padding: 8mm !important;
          gap: 5mm !important;
          break-inside: avoid;
        }
        #budget .pay { grid-column: 1 / -1 !important; }
        #budget .commercial-breakdown,
        #budget .complimentary-services { break-inside: auto; }
        #budget .commercial-head,
        #budget .complimentary-head { padding: 5mm !important; }
        #budget .commercial-table { min-width: 0 !important; font-size: 7.5pt; }
        #budget .commercial-table thead { display: table-header-group; }
        #budget .commercial-table tr { break-inside: avoid; }
        #budget .commercial-table thead th { padding: 2.2mm 2.5mm !important; font-size: 6.5pt !important; }
        #budget .commercial-table tbody td { padding: 2.2mm 2.5mm !important; font-size: 7pt !important; line-height: 1.25 !important; }
        #budget .commercial-table tbody td:nth-child(2) b { font-size: 7.5pt !important; }
        #budget .commercial-table tbody td:last-child strong { font-size: 7.5pt !important; }
        #budget .commercial-table tfoot td { padding: 3mm 2.5mm !important; }
        #budget .complimentary-services .third-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 2.5mm !important; padding: 0 4mm !important; }
        #budget .complimentary-services .third { min-height: 0 !important; padding: 3mm !important; break-inside: avoid; }
        #budget .maintenance-card { break-inside: avoid; }
      }
    </style>

    <style id="relevant-work-section">
      #work.work-closing {
        background: linear-gradient(145deg, #ffffff, #e8faf4);
        min-height: 0;
        padding-bottom: 24px;
      }
