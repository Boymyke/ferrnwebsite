        border-top: 2px solid rgba(10,42,34,.16);
      }
      #budget .commercial-table .included-row td:last-child strong {
        color: #00936d;
        font-size: 13px;
        font-weight: 900;
      }
      #budget .commercial-table .included-row .scope-tag {
        background: rgba(0,147,109,.09);
        color: #007a5e;
      }
      #budget .scope-tag {
        display: inline-flex;
        margin-top: 6px;
